{
  "name": "crossknowledge/stream-data-bundle",
  "description": "Symfony bundle for high-performance CSV stream processing with error handling and memory optimization",
  "type": "symfony-bundle",
  "license": "MIT",
  "homepage": "https://github.com/crossknowledge/stream-data-bundle",
  "keywords": [
    "csv",
    "stream",
    "symfony",
    "psr-7",
    "http-streaming"
  ],
  "authors": [
    {
      "name": "Kevin De Cruz",
      "email": "kevin.decruz@crossknowledge.com",
      "role": "Maintainer"
    }
  ],
  "support": {
    "issues": "https://github.com/crossknowledge/stream-data-bundle/issues",
    "source": "https://github.com/crossknowledge/stream-data-bundle"
  },
  "autoload": {
    "psr-4": {
      "CrossKnowledge\\StreamDataBundle\\": "src/",
      "CrossKnowledge\\StreamDataBundle\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^7.4",
    "ext-json": "*",
    "symfony/config": "^5.4",
    "symfony/dependency-injection": "^5.4",
    "symfony/http-kernel": "^5.4",
    "symfony/console": "^5.4",
    "symfony/filesystem": "^5.4",
    "guzzlehttp/guzzle": "^7.0",
    "doctrine/dbal": "^3.0"
  },
  "conflict": {
    "propel/propel1": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "symfony/phpunit-bridge": "^5.4",
    "vimeo/psalm": "^5.0"
  },
  "scripts": {
    "post-update-cmd": "@auto-scripts",
    "static-analysis": "psalm --show-info=false",
    "test": "phpunit"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "symfony/flex": true
    },
    "sort-packages": true,
    "platform": {
      "php": "7.4"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CrossKnowledge\\StreamDataBundle\\Tests\\": "tests/"
    }
  }
}
